diff --git a/src/adventurer_comfort.hpp b/src/adventurer_comfort.hpp
new file mode 100644
index 0000000..d0c5b70
--- /dev/null
+++ b/src/adventurer_comfort.hpp
@@ -0,0 +1,50 @@
+#pragma once
+
+#include <cstdint>
+
+// Pure policy helpers for the Adventurer comfort controls. Keeping these
+// decisions independent from engine state makes their default-preservation
+// and controller-isolation rules inexpensive to test.
+namespace AdventurerComfort
+{
+// SDL window IDs are nonzero. Controller-generated mouse motion uses the
+// invalid ID so physical window events remain distinguishable.
+constexpr std::uint32_t controllerMouseEventWindowId = 0;
+
+constexpr bool isControllerMouseEvent(const std::uint32_t windowId) noexcept
+{
+	return windowId == controllerMouseEventWindowId;
+}
+
+constexpr bool shouldMarkMouseCameraInput(
+	const int player,
+	const int keyboardPlayer,
+	const std::uint32_t windowId) noexcept
+{
+	return player == keyboardPlayer && !isControllerMouseEvent(windowId);
+}
+
+constexpr bool useMouseSmoothing(
+	const bool configuredSmoothing,
+	const bool rawMouseRequested,
+	const bool controllerConnected,
+	const bool lastCameraInputFromController) noexcept
+{
+	return configuredSmoothing
+		&& !(rawMouseRequested && !(controllerConnected && lastCameraInputFromController));
+}
+
+constexpr bool useCameraBobbing(
+	const bool configuredBobbing,
+	const bool noBobRequested) noexcept
+{
+	return configuredBobbing && !noBobRequested;
+}
+
+constexpr bool useSideSway(
+	const bool noBobRequested,
+	const bool noSideSwayRequested) noexcept
+{
+	return !noBobRequested && !noSideSwayRequested;
+}
+}
