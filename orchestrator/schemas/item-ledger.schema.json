{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "barony-item-ledger-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "entries"],
  "properties": {
    "schema_version": {"const": 1}, "kind": {"const": "item"},
    "entries": {"type": "array", "items": {"$ref": "#/$defs/entry"}}
  },
  "$defs": {"entry": {
    "type": "object", "required": ["id", "public_label", "status", "provenance"],
    "properties": {
      "id": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{1,79}$"},
      "public_label": {"type": "string"}, "status": {"enum": ["gap", "draft", "reviewed", "tested"]},
      "provenance": {"type": "array", "items": {"type": "string"}},
      "contains_secret": {"type": "boolean"}, "interaction_gaps": {"type": "array", "items": {"type": "string"}}
    }
  }}
}

